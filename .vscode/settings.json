{
  // ===================
  // Editor
  // ===================
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": false,

  // ===================
  // ESLint
  // ===================
  // Cada archivo usa el eslint.config.js de su paquete (default en ESLint 10).
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.options": { "flags": ["v10_config_lookup_from_file"] },
  // Además de JS/TS, lintea los JSON (package.json, tsconfig, etc.).
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "json", "jsonc"],

  // ===================
  // TypeScript
  // ===================
  // Usar el TypeScript del repo y no el que trae VS Code.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ===================
  // Explorador
  // ===================
  // Agrupa la configuración debajo del package.json de cada carpeta (se expande con la flecha).
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "yarn.lock, tsconfig*.json, eslint.config.mjs, .prettierrc.cjs, vitest.config.ts, .gitignore",
    "README.md": "AGENTS.md, CLAUDE.md, CONTRIBUTING.md, SECURITY.md, CHANGELOG.md, LICENSE, llms.txt"
  },
  // Generados que no se tocan nunca.
  "files.exclude": {
    "**/coverage": true
  },

  // ===================
  // Proyecto
  // ===================
  // Fuera de la búsqueda: build, cobertura y lockfile.
  "search.exclude": {
    "dist/**": true,
    "coverage/**": true,
    "yarn.lock": true
  }
}
